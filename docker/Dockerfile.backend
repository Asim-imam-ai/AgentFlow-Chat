# ==============================================================================
# Stage 1 — Dependency builder
# Installs all Python dependencies into an isolated venv using uv.
# This stage is discarded from the final image; only /app/.venv is kept.
# ==============================================================================
FROM python:3.12-slim AS builder

# Harden pip / python layers
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install uv from official image (single binary, no extra deps)
COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /bin/uv

WORKDIR /app

# Copy dependency manifests first — this layer is cached as long as they don't change
COPY pyproject.toml uv.lock ./

# Sync production dependencies into the project's venv; no editable install
RUN uv sync --frozen --no-cache --no-dev


# ==============================================================================
# Stage 2 — Production runtime image
# Minimal slim image. Only the app source and compiled venv are copied in.
# ==============================================================================
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENVIRONMENT=production \
    # Tell Python to find packages inside the uv-managed venv
    PATH="/app/.venv/bin:$PATH"

# Create a non-root user and group
RUN groupadd --system agentflow \
    && useradd --system --gid agentflow --no-create-home agentflow

WORKDIR /app

# Pull the populated virtualenv from the builder stage
COPY --from=builder /app/.venv /app/.venv

# Copy application source (no .venv, no __pycache__, see .dockerignore)
COPY --chown=agentflow:agentflow app/       ./app/
COPY --chown=agentflow:agentflow exceptions/ ./exceptions/
COPY --chown=agentflow:agentflow utils/      ./utils/
COPY --chown=agentflow:agentflow pyproject.toml ./

# Create persistent data directories with correct ownership
RUN mkdir -p /app/data /app/uploads \
    && chown -R agentflow:agentflow /app/data /app/uploads

# Drop to non-root
USER agentflow

EXPOSE 8000

# Health check — polls the /api/health endpoint every 30 s
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')" \
    || exit 1

# Production entrypoint — no --reload, workers = (2 × CPU cores) + 1
ENTRYPOINT ["python", "-m", "uvicorn", "app.main:app", \
            "--host", "0.0.0.0", \
            "--port", "8000", \
            "--workers", "2", \
            "--log-level", "info", \
            "--no-access-log"]
