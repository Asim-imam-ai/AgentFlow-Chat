# ==============================================================================
# Stage 1 — Dependency builder
# ==============================================================================
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./

# Install all deps (Streamlit is in the same pyproject; no dev extras needed)
RUN uv sync --frozen --no-cache --no-dev


# ==============================================================================
# Stage 2 — Production Streamlit runtime
# ==============================================================================
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENVIRONMENT=production \
    # Backend API base URL — override via docker-compose env
    BACKEND_URL=http://backend:8000 \
    PATH="/app/.venv/bin:$PATH"

# Non-root user
RUN groupadd --system agentflow \
    && useradd --system --gid agentflow --no-create-home agentflow

WORKDIR /app

# Pull virtualenv from builder
COPY --from=builder /app/.venv /app/.venv

# Copy only the frontend source and shared helpers
COPY --chown=agentflow:agentflow frontend/ ./frontend/
COPY --chown=agentflow:agentflow pyproject.toml ./

# Streamlit configuration — no browser auto-open, no telemetry, headless mode
RUN mkdir -p /home/agentflow/.streamlit
COPY --chown=agentflow:agentflow docker/streamlit_config.toml /home/agentflow/.streamlit/config.toml

USER agentflow

EXPOSE 8501

# Health check — Streamlit exposes a health endpoint at /_stcore/health
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" \
    || exit 1

ENTRYPOINT ["python", "-m", "streamlit", "run", "frontend/app.py", \
            "--server.port=8501", \
            "--server.address=0.0.0.0", \
            "--server.headless=true", \
            "--browser.gatherUsageStats=false"]
